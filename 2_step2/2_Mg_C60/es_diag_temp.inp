&GLOBAL
   PRINT_LEVEL  MEDIUM
   PROJECT_NAME Diag_libra
   RUN_TYPE  ENERGY
&END GLOBAL
&FORCE_EVAL
  METHOD  QS
  &PROPERTIES
    &TDDFPT
       NSTATES     10             # number of excited states
       MAX_ITER    200            # maximum number of Davidson iterations
       CONVERGENCE [eV] 1.0e-4   # convergence on maximum energy change between iterations
       &MGRID
          NGRIDS 4
          CUTOFF 100
       &END
       !RESTART     .TRUE.
    &END TDDFPT
  &END PROPERTIES
  &DFT
    UKS .FALSE.
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    BASIS_SET_FILE_NAME BASIS_ADMM
    POTENTIAL_FILE_NAME POTENTIAL
    WFN_RESTART_FILE_NAME mg_c60-RESTART.wfn
    &MGRID
      NGRIDS 4
      CUTOFF 300
      REL_CUTOFF 50
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-15
      EPS_PGF_ORB 1.0E-10
    &END QS
    !&AUXILIARY_DENSITY_MATRIX_METHOD
    !  METHOD BASIS_PROJECTION
    !  ADMM_PURIFICATION_METHOD NONE  
    !  EXCH_CORRECTION_FUNC BECKE88X
    !&END AUXILIARY_DENSITY_MATRIX_METHOD
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END
    &SCF
      &DIAGONALIZATION
      &END DIAGONALIZATION
      &MIXING
        ALPHA 0.1
        METHOD BROYDEN_MIXING
        NBROYDEN 8
      &END MIXING
      EPS_SCF 1.0E-6
      SCF_GUESS RESTART
      MAX_SCF  500
      ADDED_MOS 60
    &END SCF
    &XC
      &XC_FUNCTIONAL
         &PBE
         &END
      !  &BECKE88
      !    SCALE_X 0.81
      !  &END BECKE88
      !  &BECKE88_LR
      !    SCALE_X -0.46
      !    OMEGA 0.33
      !  &END BECKE88_LR
      !  &LYP
      !    SCALE_C 0.81
      !  &END LYP
      !  &VWN
      !    FUNCTIONAL_TYPE VWN5
      !    SCALE_C 0.19
      !  &END VWN
      !&END XC_FUNCTIONAL
      !&HF
      !  &INTERACTION_POTENTIAL
      !    POTENTIAL_TYPE MIX_CL_TRUNC
      !    CUTOFF_RADIUS 7.0
      !    OMEGA 0.33
      !    SCALE_COULOMB 0.19
      !    SCALE_LONGRANGE 0.46
      !    T_C_G_DATA t_c_g.dat
      !  &END
      !  &SCREENING
      !    EPS_SCHWARZ 1.0E-6
      !  &END
      !  &MEMORY
      !    MAX_MEMORY  5200
      !    EPS_STORAGE_SCALING 1.0
      !  &END MEMORY
      !  FRACTION 1.0
      &END
      &XC_GRID
        XC_DERIV SPLINE2_SMOOTH
      &END XC_GRID
      &VDW_POTENTIAL
         POTENTIAL_TYPE PAIR_POTENTIAL
         &PAIR_POTENTIAL
            PARAMETER_FILE_NAME dftd3.dat
            TYPE DFTD3
            REFERENCE_FUNCTIONAL PBE
            R_CUTOFF [angstrom] 16
         &END
      &END VDW_POTENTIAL
    &END XC
    &PRINT
      &MULLIKEN OFF
      &END
      &HIRSHFELD OFF
      &END
      &MO ON
        FILENAME Diag_libra
        EIGENVECTORS F
        EIGENVALUES F
        NDIGITS 8
      &END
      &PDOS
        APPEND T
        COMPONENTS T
        FILENAME Diag_libra
      &END
      &MO_MOLDEN ON
        FILENAME
        NDIGITS 8
        GTO_KIND SPHERICAL
      &END
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      A         21.11248916         0.0000000000        0.0000000000
      B         0.0000000000        21.11248916         0.0000000000
      C         0.0000000000        0.0000000000        21.11248916
      PERIODIC  NONE
    &END CELL
    &TOPOLOGY
      COORD_FILE_NAME C60_Mg.xyz
      COORD_FILE_FORMAT XYZ
      &CENTER_COORDINATES T
      &END
    &END
    &KIND  C
      BASIS_SET DZVP-MOLOPT-GTH
      !BASIS_SET AUX_FIT cpFIT3
      POTENTIAL GTH-PBE-q4
    &END KIND
    &KIND  Mg
      ELEMENT Mg
      BASIS_SET DZVP-MOLOPT-SR-GTH
      !BASIS_SET AUX_FIT cpFIT3
      POTENTIAL GTH-PBE-q10
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
